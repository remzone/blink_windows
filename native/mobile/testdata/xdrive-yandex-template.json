{
  "flatten": true,
  "concurrency": 4,
  "auth": {
    "type": "static",
    "header": {
      "Authorization": "OAuth {secret0}"
    }
  },
  "put": {
    "method": "GET",
    "url": "https://cloud-api.yandex.net/v1/disk/resources/upload?path={folder}/{name}&overwrite=true",
    "hrefPath": "href",
    "hrefMethod": "PUT"
  },
  "get": {
    "method": "GET",
    "url": "https://cloud-api.yandex.net/v1/disk/resources/download?path={folder}/{name}",
    "hrefPath": "href",
    "hrefMethod": "GET"
  },
  "list": {
    "method": "GET",
    "url": "https://cloud-api.yandex.net/v1/disk/resources?path={folder}&limit=1000&fields=_embedded.items.name",
    "namesRegex": "\"name\"\\s*:\\s*\"([^\"\\\\]+)\""
  },
  "delete": {
    "method": "DELETE",
    "url": "https://cloud-api.yandex.net/v1/disk/resources?path={folder}/{name}&permanently=true"
  },
  "retry": {
    "status": [429, 500, 502, 503, 504]
  }
}
